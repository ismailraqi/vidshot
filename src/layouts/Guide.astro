---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
interface Props { frontmatter: { title: string; description: string; readingTime: string; }; }
const { title, description, readingTime } = Astro.props.frontmatter;
---
<Base title={`${title} — VidShot Guide`} description={description}>
  <article class="article wrap">
    <a class="text-link breadcrumb" href="/guides/">← All guides</a>
    <header class="article-header"><p class="eyebrow">VIDSHOT GUIDE · {readingTime}</p><h1>{title}</h1><p class="article-intro">{description}</p></header>
    <div class="prose"><slot /></div>
    <aside class="article-callout"><Icon name="play" size={28} /><div><h2>{site.launchStatus === 'available' ? 'Your video companion is here.' : 'A video companion, coming soon.'}</h2><p>{site.launchStatus === 'available' ? 'Discover VidShot for iPhone and iPad.' : 'VidShot is coming soon on the App Store for iPhone and iPad.'}</p><a class="text-link" href="/">Explore VidShot <Icon name="arrow" size={18} /></a></div></aside>
  </article>
</Base>
